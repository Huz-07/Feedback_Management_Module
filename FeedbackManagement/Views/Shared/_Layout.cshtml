<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Feedback Management System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        .header {
            padding: 12px;
            border: 1px solid #ccc;
            font-size: 20px;
            font-weight: bold;
        }

        .container {
            padding: 20px;
        }

        .row {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .form-section, .list-section {
            flex: 1;
            min-width: 0;
        }

        .form-section {
            border: 1px solid #ccc;
            padding: 15px;
        }

        label {
            display: block;
            margin-top: 12px;
        }

        input, select, textarea {
            width: 100%;
            padding: 9px;
            margin-top: 5px;
            box-sizing: border-box;
        }

        button, .btn {
            padding: 10px 15px;
            margin-top: 12px;
            cursor: pointer;
        }

        .error {
            color: red;
            font-size: 13px;
        }

        .success {
            padding: 10px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
            overflow-wrap: anywhere;
        }

      @@media (max-width: 700px) {
            .row {
                flex-direction: column;
            }

            .form-section, .list-section {
                width: 100%;
                box-sizing: border-box;
            }
        }
    </style>
</head>
<body>

    <div class="header">
        Feedback Management System
    </div>

    <div class="container">
        @RenderBody()
    </div>

    @RenderSection("scripts", required: false)

</body>
</html>
